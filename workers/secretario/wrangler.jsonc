{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secretario",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Latido cada 30 minutos: tareas programadas, correos importantes, agenda próxima.
  "triggers": { "crons": ["*/30 * * * *"] },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secretario",
      "database_id": "2b9fb3a5-d6b7-4ed5-b5f9-032a47b1e3f5",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [
    { "binding": "VECTORS", "index_name": "secretario-memoria" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SecretarioSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SecretarioSession"] }
  ],
  "vars": {
    "BOT_NAME": "Secretario",
    "OWNER_NAME": "Pablo",
    "OWNER_EMAIL": "info@apdsport.com",
    "TIMEZONE": "Europe/Madrid",
    "LANGUAGE": "es",
    // Presupuesto diario de neuronas de Workers AI (el plan gratuito da 10.000). Se reserva margen.
    "DAILY_NEURON_BUDGET": "9000",
    // Cadenas de modelos: proveedor:modelo, en orden de preferencia. Se salta al siguiente si falla o se agota el presupuesto.
    "MODEL_CHAIN_SMART": "cf:@cf/openai/gpt-oss-120b,gemini:gemini-3.6-flash,groq:openai/gpt-oss-120b,cf:@cf/meta/llama-4-scout-17b-16e-instruct,openrouter:meta-llama/llama-3.3-70b-instruct:free",
    "MODEL_CHAIN_FAST": "cf:@cf/meta/llama-3.1-8b-instruct-fp8-fast,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-20b,cf:@cf/qwen/qwen3-30b-a3b-fp8",
    "MODEL_VISION": "@cf/meta/llama-3.2-11b-vision-instruct",
    "MODEL_STT": "@cf/openai/whisper-large-v3-turbo",
    "MODEL_EMBED": "@cf/baai/bge-m3",
    "HEARTBEAT_ENABLED": "true",
    "QUIET_HOURS": "23-07",
    "MAX_AGENT_STEPS": "10"
  }
}
